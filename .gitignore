# Datasheet PDFs are large — regenerate with: bomi datasheet CXXXXX --pdf -o docs/datasheets/
docs/datasheets/*.pdf
docs/datasheets/*.PDF

# KiCad: per-user view state, locks, backups, caches, local history
*.kicad_prl
*.lck
*-backups/
fp-info-cache
.history/
drc.rpt
__pycache__/
.DS_Store

# order files (scripts/make_fab.sh) and raw simulation waveforms (sim/channel.py --plot); the tables and PNGs are kept
build/
# the boards' STEPs that mech/housing's scripts load (exported by kicad-cli, see mech/housing/README.md)
mech/out/
sim/results/*_full.txt
sim/results/*_pwm*.txt
sim/results/deck.cir

# Each open order's upload folder, rebuilt by `pcbkit production` from the pinned release
production/orders/*/upload/
